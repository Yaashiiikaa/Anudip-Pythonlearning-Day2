<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mutability Lab — Python objects, live</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
:root{
  color-scheme: light;
  --paper:#FFFFFF; --panel:#F2F6FA; --panel2:#E9EFF5; --line:#C9D5E0;
  --ink:#16222E; --muted:#45586B;
  --blue:#2B5B84; --blue-ink:#FFFFFF;
  --amber:#8A5C00; --amber-bg:#FFF2CC; --amber-line:#E3C76E;
  --good:#1F6E43; --good-bg:#E2F2E8;
  --bad:#9B2C2C; --bad-bg:#FBE4E4;
  --box:#FFFFFF; --box-line:#9FB4C6; --ghost:#8A98A6;
  --code:#0E161F; --code-ink:#E8EEF4; --code-amber:#FFD166;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --paper:#10171E; --panel:#17212B; --panel2:#1D2935; --line:#2C3D4D;
    --ink:#E7EDF3; --muted:#9FB0C0;
    --blue:#6FA3D2; --blue-ink:#0E161F;
    --amber:#E8BE5A; --amber-bg:#2A2410; --amber-line:#5C4D1E;
    --good:#7CC89D; --good-bg:#15281E;
    --bad:#E89090; --bad-bg:#2E1717;
    --box:#141D26; --box-line:#3C5168; --ghost:#5E6E7E;
    --code:#0B1218; --code-ink:#DCE6EF; --code-amber:#FFD166;
  }
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --paper:#10171E; --panel:#17212B; --panel2:#1D2935; --line:#2C3D4D;
  --ink:#E7EDF3; --muted:#9FB0C0;
  --blue:#6FA3D2; --blue-ink:#0E161F;
  --amber:#E8BE5A; --amber-bg:#2A2410; --amber-line:#5C4D1E;
  --good:#7CC89D; --good-bg:#15281E;
  --bad:#E89090; --bad-bg:#2E1717;
  --box:#141D26; --box-line:#3C5168; --ghost:#5E6E7E;
  --code:#0B1218; --code-ink:#DCE6EF; --code-amber:#FFD166;
}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html,body{height:100%}
body{
  margin:0; background:var(--paper); color:var(--ink);
  font-family:'Space Grotesk',system-ui,sans-serif; font-size:16px; line-height:1.5;
}
.mono{font-family:'JetBrains Mono',ui-monospace,monospace}
.wrap{max-width:860px; margin:0 auto; padding:20px 16px 56px}
header.site{padding:18px 0 6px}
.kicker{font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--blue); font-weight:600}
h1{font-size:clamp(28px,6vw,40px); line-height:1.08; margin:4px 0 6px; letter-spacing:-0.5px}
.sub{color:var(--muted); max-width:56ch; margin:0}
.motto{
  display:inline-block; margin-top:14px; font-family:'JetBrains Mono',monospace; font-weight:600;
  font-size:14px; color:var(--code-amber); background:var(--code); border-radius:8px; padding:8px 14px;
}
section{margin-top:40px}
h2{font-size:22px; margin:0 0 4px}
.lede{color:var(--muted); margin:0 0 14px; max-width:60ch}
.card{background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:16px}

/* type chips */
.chips{display:flex; flex-wrap:wrap; gap:8px; margin:10px 0 4px}
.chipgrp{font-size:13px; color:var(--muted); width:100%; margin-top:4px}
button.chip{
  font-family:'JetBrains Mono',monospace; font-size:14px; cursor:pointer;
  padding:8px 13px; border-radius:99px; border:1.5px solid var(--line);
  background:var(--paper); color:var(--ink); min-height:40px;
}
button.chip[aria-pressed="true"]{background:var(--blue); color:var(--blue-ink); border-color:var(--blue)}
button.chip:focus-visible, button:focus-visible{outline:3px solid var(--blue); outline-offset:2px}

/* stage */
.stage{position:relative; display:flex; gap:28px; align-items:flex-start; margin-top:14px; min-height:150px}
.namecol{flex:0 0 auto; position:sticky; top:12px; display:flex; flex-direction:column; gap:10px; padding-top:6px}
.nametag{
  font-family:'JetBrains Mono',monospace; font-weight:600; font-size:17px;
  background:var(--amber-bg); color:var(--amber); border:1.5px solid var(--amber-line);
  border-radius:8px; padding:7px 13px; text-align:center;
}
.nametag .nlabel{display:block; font-size:10.5px; font-weight:400; color:var(--muted); font-family:'Space Grotesk',sans-serif}
.boxcol{flex:1 1 auto; display:flex; flex-direction:column; gap:12px; min-width:0}
svg.wires{position:absolute; inset:0; width:100%; height:100%; pointer-events:none; overflow:visible}
svg.wires path{fill:none; stroke:var(--amber); stroke-width:2.5}
svg.wires .wire-b{stroke:var(--blue)}
svg.wires marker path{fill:var(--amber); stroke:none}
svg.wires marker.mb path{fill:var(--blue)}
.obox{
  background:var(--box); border:1.8px solid var(--box-line); border-radius:10px; overflow:hidden;
  transition:opacity .3s, border-color .3s;
}
.obox .ohead{
  display:flex; justify-content:space-between; gap:8px; flex-wrap:wrap;
  font-family:'JetBrains Mono',monospace; font-size:12.5px;
  background:var(--panel2); color:var(--muted); padding:6px 11px; border-bottom:1px solid var(--line);
}
.obox .oval{font-family:'JetBrains Mono',monospace; font-size:16px; padding:11px 12px; word-break:break-all}
.obox.active{border-color:var(--blue)}
.obox.ghost{opacity:.45}
.obox.ghost .ohead::after{content:"unreferenced → garbage collected"; color:var(--ghost)}
.obox.pulse{animation:pulse .5s}
.obox.born{animation:born .4s}
@keyframes pulse{0%{box-shadow:0 0 0 0 color-mix(in srgb, var(--blue) 55%, transparent)}100%{box-shadow:0 0 0 14px transparent}}
@keyframes born{from{transform:translateY(8px); opacity:0}to{transform:none; opacity:1}}
.shake{animation:shake .35s}
@keyframes shake{0%,100%{transform:none}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
@media (prefers-reduced-motion: reduce){
  .obox.pulse,.obox.born,.shake{animation:none}
  *{transition:none !important}
}

/* op buttons + verdict + log */
.ops{display:flex; flex-wrap:wrap; gap:8px; margin-top:16px}
button.op{
  font-family:'JetBrains Mono',monospace; font-size:14.5px; cursor:pointer; min-height:44px;
  padding:9px 14px; border-radius:9px; border:1.5px solid var(--blue);
  background:var(--paper); color:var(--blue); font-weight:600;
}
button.op.warn{border-color:var(--bad); color:var(--bad)}
button.op.quiet{border-color:var(--line); color:var(--muted); font-weight:400}
.verdict{margin-top:14px; border-radius:9px; padding:10px 13px; font-size:15px; display:none}
.verdict.show{display:block}
.verdict.same{background:var(--good-bg); color:var(--good)}
.verdict.new{background:var(--amber-bg); color:var(--amber)}
.verdict.err{background:var(--bad-bg); color:var(--bad)}
.verdict.info{background:var(--panel2); color:var(--muted); border:1px solid var(--line)}
.log{
  margin-top:14px; background:var(--code); color:var(--code-ink); border-radius:10px;
  font-family:'JetBrains Mono',monospace; font-size:13.5px; line-height:1.65;
  padding:12px 14px; max-height:190px; overflow:auto;
}
.log .lc{color:var(--code-amber)}
.log .lid{color:#8FB8DB}
.log .lerr{color:#F0A0A0}
.log:empty{display:none}
.tryrow{display:flex; gap:8px; margin-top:14px}
.tryrow input{
  flex:1 1 auto; min-width:0; min-height:44px; font-family:'JetBrains Mono',ui-monospace,monospace; font-size:14.5px;
  padding:9px 12px; border-radius:9px; border:1.5px solid var(--line); background:var(--paper); color:var(--ink);
}
.tryrow input:focus-visible{outline:3px solid var(--blue); outline-offset:2px}
.tryhint{margin-top:8px; font-size:13.5px; color:var(--muted)}

/* alias stepper */
.alias-pick{display:flex; gap:8px; margin-bottom:12px}
.steps{display:flex; flex-direction:column; gap:8px; margin-top:16px}
button.step{
  text-align:left; font-family:'JetBrains Mono',monospace; font-size:14.5px; cursor:pointer;
  padding:11px 14px; border-radius:9px; border:1.5px solid var(--line);
  background:var(--paper); color:var(--ink); min-height:44px;
}
button.step:disabled{opacity:.45; cursor:default}
button.step .snote{display:block; font-family:'Space Grotesk',sans-serif; font-size:13px; color:var(--muted)}

/* quiz */
.qcard{margin-top:12px}
.qscen{font-size:17px; margin:2px 0 14px}
.qbtns{display:flex; gap:10px; flex-wrap:wrap}
button.qa{
  flex:1 1 180px; min-height:52px; cursor:pointer; font-size:15.5px; font-weight:600;
  border-radius:10px; padding:10px 14px; font-family:'Space Grotesk',sans-serif;
}
button.qa.build{border:1.8px solid var(--blue); background:var(--paper); color:var(--blue)}
button.qa.share{border:1.8px solid var(--amber-line); background:var(--amber-bg); color:var(--amber)}
.qfeed{margin-top:12px; border-radius:9px; padding:10px 13px; font-size:15px; display:none}
.qfeed.show{display:block}
.qfeed.right{background:var(--good-bg); color:var(--good)}
.qfeed.wrong{background:var(--bad-bg); color:var(--bad)}
.qmeta{display:flex; justify-content:space-between; color:var(--muted); font-size:14px; margin-top:12px}
button.linkish{border:none; background:none; color:var(--blue); font:inherit; cursor:pointer; text-decoration:underline; padding:4px}
footer{margin-top:48px; color:var(--muted); font-size:13.5px}
</style>
</head>
<body>
<div class="wrap">

<header class="site">
  <div class="kicker">Python foundations · Day 2</div>
  <h1>Mutability Lab</h1>
  <p class="sub">Every Python object is identity + type + value, and a name is just a movable label. Press the buttons and watch which one changes.</p>
  <span class="motto">build mutable · share immutable</span>
</header>

<section aria-labelledby="h-stage">
  <h2 id="h-stage">1 · The identity experiment</h2>
  <p class="lede">Pick a type, then run an operation on the name <span class="mono">x</span>. If the arrow jumps to a brand-new box, the type is immutable. If the same box changes, it’s mutable. You can also type your own line and press run.</p>

  <div class="card">
    <div class="chips" id="chips" role="group" aria-label="Choose a Python type"></div>
    <div class="stage" id="stage">
      <svg class="wires" id="wires" aria-hidden="true">
        <defs>
          <marker id="arrA" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z"></path></marker>
          <marker id="arrB" class="mb" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z"></path></marker>
        </defs>
        <path id="wireA" marker-end="url(#arrA)" d=""></path>
      </svg>
      <div class="namecol"><div class="nametag" id="nameA">x<span class="nlabel">name</span></div></div>
      <div class="boxcol" id="boxes"></div>
    </div>
    <div class="ops" id="ops"></div>
    <div class="tryrow">
      <input id="custom" autocomplete="off" spellcheck="false" placeholder="or type your own line on x…" aria-label="Type your own operation on x">
      <button class="op" id="runCustom">run</button>
    </div>
    <div class="tryhint" id="tryhint"></div>
    <div class="verdict" id="verdict" role="status"></div>
    <div class="log mono" id="log" aria-live="polite"></div>
  </div>
</section>

<section aria-labelledby="h-alias">
  <h2 id="h-alias">2 · Two names, one object</h2>
  <p class="lede">Mutability only bites when an object is shared. Walk the steps in order and watch whether <span class="mono">a</span> sees what happens through <span class="mono">b</span>.</p>

  <div class="card">
    <div class="alias-pick" role="group" aria-label="Choose the demo type">
      <button class="chip" id="al-list" aria-pressed="true">list (mutable)</button>
      <button class="chip" id="al-str" aria-pressed="false">str (immutable)</button>
    </div>
    <div class="stage" id="astage">
      <svg class="wires" id="awires" aria-hidden="true">
        <path id="awireA" marker-end="url(#arrA)" d=""></path>
        <path id="awireB" class="wire-b" marker-end="url(#arrB)" d=""></path>
      </svg>
      <div class="namecol">
        <div class="nametag" id="anameA">a<span class="nlabel">name</span></div>
        <div class="nametag" id="anameB" style="visibility:hidden">b<span class="nlabel">name</span></div>
      </div>
      <div class="boxcol" id="aboxes"></div>
    </div>
    <div class="steps" id="asteps"></div>
    <div class="verdict" id="averdict" role="status"></div>
  </div>
</section>

<section aria-labelledby="h-cache">
  <h2 id="h-cache">3 · Does Python reuse values?</h2>
  <p class="lede">A common guess: “the value 5 already exists, so Python points <span class="mono">y</span> at it.” Walk the steps and see when sharing really happens — and why it is never a lookup by value.</p>

  <div class="card">
    <div class="chips" id="cchips" role="group" aria-label="Choose a value"></div>
    <div class="stage" id="cstage">
      <svg class="wires" aria-hidden="true">
        <path id="cwireA" marker-end="url(#arrA)" d=""></path>
        <path id="cwireB" class="wire-b" marker-end="url(#arrB)" d=""></path>
      </svg>
      <div class="namecol">
        <div class="nametag" id="cnameA">x<span class="nlabel">name</span></div>
        <div class="nametag" id="cnameB" style="visibility:hidden">y<span class="nlabel">name</span></div>
      </div>
      <div class="boxcol" id="cboxes"></div>
    </div>
    <div class="steps" id="csteps"></div>
    <div class="verdict" id="cverdict" role="status"></div>
    <p class="tryhint">As in the interactive Python shell — inside a .py file the compiler may fold equal constants into one object.</p>
  </div>
</section>

<section aria-labelledby="h-quiz">
  <h2 id="h-quiz">4 · Build or share?</h2>
  <p class="lede">For each real-world situation, decide: build it with a mutable type, or share it as an immutable one.</p>

  <div class="card qcard">
    <p class="qscen" id="qscen"></p>
    <div class="qbtns">
      <button class="qa build" id="qbuild">Build it — mutable</button>
      <button class="qa share" id="qshare">Share it — immutable</button>
    </div>
    <div class="qfeed" id="qfeed" role="status"></div>
    <div class="qmeta">
      <span id="qprog"></span>
      <span id="qscore"></span>
    </div>
  </div>
</section>

<footer>
  The addresses shown are simulated, but they behave exactly like CPython’s <span class="mono">id()</span>: fixed for an object’s lifetime, different for every new object. Run the same experiments in real Python with <span class="mono">id(x)</span>.
</footer>
</div>

<script>
(function(){
"use strict";
var nextAddr = 0x7f3a2c100040;
function newAddr(){ nextAddr += 0x40 * (1 + Math.floor(Math.random()*5)); return "0x" + nextAddr.toString(16); }
function esc(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

/* ---------- type configs ---------- */
function immOps(ops, tryMut){ var o = ops.slice(); if (tryMut) o.push(tryMut); return o; }
var TYPES = {
  "int":      {mut:false, init:function(){return 5;}, show:function(v){return String(v);},
               ops:[ {code:"x += 1", f:function(v){return v+1;}}, {code:"x = x * 2", f:function(v){return v*2;}} ]},
  "float":    {mut:false, init:function(){return 3.14;}, show:function(v){return String(v);},
               ops:[ {code:"x += 0.5", f:function(v){return Math.round((v+0.5)*100)/100;}} ]},
  "bool":     {mut:false, init:function(){return true;}, show:function(v){return v ? "True" : "False";},
               ops:[ {code:"x = not x", f:function(v){return !v;}} ]},
  "str":      {mut:false, init:function(){return "hi";}, show:function(v){return '"' + v + '"';},
               ops:[ {code:'x += "!"', f:function(v){return v + "!";}},
                     {code:"x = x.upper()", f:function(v){return v.toUpperCase();}},
                     {code:'x[0] = "H"', err:"TypeError: 'str' object does not support item assignment"} ]},
  "tuple":    {mut:false, init:function(){return [1,2];}, show:function(v){return "(" + v.join(", ") + ")";},
               ops:[ {code:"x += (9,)", f:function(v){return v.concat([9]);}},
                     {code:"x[0] = 99", err:"TypeError: 'tuple' object does not support item assignment"} ]},
  "frozenset":{mut:false, init:function(){return [1,2];}, show:function(v){return "frozenset({" + v.join(", ") + "})";},
               ops:[ {code:"x = x | {9}", f:function(v){return v.indexOf(9)<0 ? v.concat([9]) : v;}},
                     {code:"x.add(9)", err:"AttributeError: 'frozenset' object has no attribute 'add'"} ]},
  "bytes":    {mut:false, init:function(){return "hi";}, show:function(v){return 'b"' + v + '"';},
               ops:[ {code:'x += b"!"', f:function(v){return v + "!";}},
                     {code:"x[0] = 72", err:"TypeError: 'bytes' object does not support item assignment"} ]},
  "list":     {mut:true, init:function(){return [1,2,3];}, show:function(v){return "[" + v.join(", ") + "]";},
               ops:[ {code:"x.append(9)", f:function(v){v.push(9); return v;}},
                     {code:"x[0] = 99", f:function(v){v[0]=99; return v;}},
                     {code:"x.pop()", f:function(v){if(v.length)v.pop(); return v;}} ]},
  "dict":     {mut:true, init:function(){return {a:1};}, show:function(v){ var p=[]; for(var k in v){p.push('"'+k+'": '+v[k]);} return "{" + p.join(", ") + "}"; },
               ops:[ {code:'x["b"] = 2', f:function(v){v.b=2; return v;}},
                     {code:'x["a"] += 10', f:function(v){v.a+=10; return v;}} ]},
  "set":      {mut:true, init:function(){return [1,2];}, show:function(v){return v.length ? "{" + v.join(", ") + "}" : "set()";},
               ops:[ {code:"x.add(9)", f:function(v){if(v.indexOf(9)<0)v.push(9); return v;}},
                     {code:"x.discard(1)", f:function(v){var i=v.indexOf(1); if(i>-1)v.splice(i,1); return v;}} ]},
  "bytearray":{mut:true, init:function(){return "hi";}, show:function(v){return 'bytearray(b"' + v + '")';},
               ops:[ {code:"x.append(33)", f:function(v){return v + "!";}} ]}
};
var IMM_ORDER = ["int","float","bool","str","tuple","frozenset","bytes"];
var MUT_ORDER = ["list","dict","set","bytearray"];

/* ---------- section 1 state ---------- */
var chipsEl = document.getElementById("chips");
var boxesEl = document.getElementById("boxes");
var opsEl = document.getElementById("ops");
var verdictEl = document.getElementById("verdict");
var logEl = document.getElementById("log");
var stageEl = document.getElementById("stage");
var curType = "int";
var curBoxes = [];   // {addr, html, state:'active'|'ghost'}
var curVal = null;

function chipBtn(label, pressed, onClick){
  var b = document.createElement("button");
  b.className = "chip"; b.textContent = label;
  b.setAttribute("aria-pressed", pressed ? "true" : "false");
  b.addEventListener("click", onClick);
  return b;
}
function buildChips(){
  chipsEl.innerHTML = "";
  var g1 = document.createElement("div"); g1.className="chipgrp"; g1.textContent="Immutable family";
  chipsEl.appendChild(g1);
  IMM_ORDER.forEach(function(t){ chipsEl.appendChild(chipBtn(t, t===curType, function(){ pickType(t); })); });
  var g2 = document.createElement("div"); g2.className="chipgrp"; g2.textContent="Mutable family";
  chipsEl.appendChild(g2);
  MUT_ORDER.forEach(function(t){ chipsEl.appendChild(chipBtn(t, t===curType, function(){ pickType(t); })); });
}
function pickType(t){
  curType = t;
  var btns = chipsEl.querySelectorAll("button.chip");
  for (var i=0;i<btns.length;i++){ btns[i].setAttribute("aria-pressed", btns[i].textContent===t ? "true" : "false"); }
  resetStage(true);
}
function cloneVal(v){
  if (Array.isArray(v)) return v.slice();
  if (v && typeof v === "object"){ var o={}; for(var k in v)o[k]=v[k]; return o; }
  return v;
}
function resetStage(clearLog){
  var cfg = TYPES[curType];
  curVal = cfg.init();
  curBoxes = [{addr:newAddr(), state:"active", born:false}];
  verdictEl.className = "verdict"; verdictEl.textContent = "";
  if (clearLog) logEl.innerHTML = "";
  renderBoxes(); buildOps(); setHint();
  logLine("x = " + cfg.show(curVal), curBoxes[0].addr, null);
}
function renderBoxes(){
  var cfg = TYPES[curType];
  boxesEl.innerHTML = "";
  // show newest first? Keep chronological top→down, arrow finds active.
  var keep = curBoxes.slice(-4);
  keep.forEach(function(b){
    var d = document.createElement("div");
    d.className = "obox " + (b.state==="active" ? "active" : "ghost") + (b.born ? " born" : "");
    d.dataset.addr = b.addr;
    d.innerHTML = '<div class="ohead"><span>id: ' + b.addr + '</span><span>type: ' + curType + '</span></div>' +
                  '<div class="oval">' + esc(b.state==="active" ? cfg.show(curVal) : b.frozen) + '</div>';
    boxesEl.appendChild(d);
    b.born = false;
  });
  requestAnimationFrame(drawWireA);
}
function buildOps(){
  var cfg = TYPES[curType];
  opsEl.innerHTML = "";
  cfg.ops.forEach(function(op){
    var b = document.createElement("button");
    b.className = "op" + (op.err ? " warn" : "");
    b.textContent = op.err ? op.code + "  (try it)" : op.code;
    b.addEventListener("click", function(){ runOp(op); });
    opsEl.appendChild(b);
  });
  var r = document.createElement("button");
  r.className = "op quiet"; r.textContent = "reset";
  r.addEventListener("click", function(){ resetStage(false); });
  opsEl.appendChild(r);
}
function runOp(op){
  var cfg = TYPES[curType];
  var act = curBoxes[curBoxes.length-1];
  if (op.err){
