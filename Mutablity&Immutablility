    d.className = "obox " + (b.state==="ghost" ? "ghost" : "active") + (b.born ? " born" : "");
    d.dataset.addr = b.addr;
    d.innerHTML = '<div class="ohead"><span>id: ' + b.addr + '</span><span>type: ' + A.type + '</span></div>' +
                  '<div class="oval">' + esc(b.val) + '</div>';
    aboxesEl.appendChild(d);
    b.born = false;
  });
  requestAnimationFrame(drawAWires);
}
function drawAWires(){
  var pa = document.getElementById("awireA"), pb = document.getElementById("awireB");
  var na = document.getElementById("anameA"), nb = document.getElementById("anameB");
  var ba = A.aAddr ? aboxesEl.querySelector('[data-addr="'+A.aAddr+'"]') : null;
  var bb = A.bAddr ? aboxesEl.querySelector('[data-addr="'+A.bAddr+'"]') : null;
  drawWire(pa, na, ba, astageEl);
  if (A.bAddr && nb.style.visibility!=="hidden"){ drawWire(pb, nb, bb, astageEl); } else { pb.setAttribute("d",""); }
}
function buildASteps(){
  var sc = SCRIPTS[A.type];
  astepsEl.innerHTML = "";
  sc.steps.forEach(function(s, i){
    var b = document.createElement("button");
    b.className = "step";
    b.innerHTML = esc(s.code) + '<span class="snote">' + esc(s.note) + '</span>';
    b.disabled = (i !== A.step);
    b.addEventListener("click", function(){ runAStep(i); });
    astepsEl.appendChild(b);
  });
  var r = document.createElement("button");
  r.className = "op quiet"; r.textContent = "reset"; r.style.marginTop = "4px";
  r.addEventListener("click", aReset);
  astepsEl.appendChild(r);
}
function runAStep(i){
  if (i !== A.step) return;
  var isList = A.type === "list";
  if (i === 0){
    var addr = newAddr();
    A.boxes = [{addr:addr, val:SCRIPTS[A.type].initVal, state:"active", born:true}];
    A.aAddr = addr;
  } else if (i === 1){
    A.bAddr = A.aAddr;
    document.getElementById("anameB").style.visibility = "visible";
  } else if (i === 2){
    if (isList){
      A.boxes[0].val = "[1, 2, 3]";
      renderA();
      var el = aboxesEl.querySelector('[data-addr="'+A.boxes[0].addr+'"]');
      if (el){ el.classList.add("pulse"); setTimeout(function(){ el.classList.remove("pulse"); }, 520); }
      A.step++; buildASteps(); drawAWires(); return;
    } else {
      var old = A.boxes[0];
      var nb2 = {addr:newAddr(), val:'"hi!"', state:"active", born:true};
      A.boxes.push(nb2);
      A.bAddr = nb2.addr;   // only b moves
    }
  } else if (i === 3){
    if (isList){
      showAV("same", "a sees [1, 2, 3] — one shared object, so the change travels. This is the mutable-default-argument trap in disguise.");
    } else {
      showAV("new", 'a still sees "hi" — b was rebound to a new string; the original was never touched. Immutables can\u2019t surprise their sharers.');
    }
  }
  A.step++;
  renderA(); buildASteps();
}
function showAV(kind, text){
  averdictEl.className = "verdict show " + kind;
  averdictEl.textContent = text;
}
document.getElementById("al-list").addEventListener("click", function(){ A.type="list"; setAliasChips(); aReset(); });
document.getElementById("al-str").addEventListener("click", function(){ A.type="str"; setAliasChips(); aReset(); });
function setAliasChips(){
  document.getElementById("al-list").setAttribute("aria-pressed", A.type==="list" ? "true":"false");
  document.getElementById("al-str").setAttribute("aria-pressed", A.type==="str" ? "true":"false");
}

/* ---------- section 3: value reuse / caching ---------- */
var CVALS = [
  {label:"5", type:"int", shared:true, why:"5 lives in the small-int cache (−5 … 256), so Python hands out the SAME pre-built object."},
  {label:"256", type:"int", shared:true, why:"256 is the last number inside the small-int cache — still the one shared object."},
  {label:"257", type:"int", shared:false, why:"257 is past the cache, so each assignment built its own object — no lookup by value ever happened."},
  {label:"5.0", type:"float", shared:false, why:"Floats are not cached — equal values, two separate objects."},
  {label:"\"hi\"", type:"str", shared:true, why:"Short identifier-like strings are interned — one shared object."},
  {label:"[1, 2]", type:"list", shared:false, why:"Lists are NEVER reused — secretly sharing a mutable object would be a disaster the moment one name appended."}
];
var C = {idx:0, step:0, boxes:[], xAddr:null, yAddr:null};
var cboxesEl = document.getElementById("cboxes");
var cstepsEl = document.getElementById("csteps");
var cverdictEl = document.getElementById("cverdict");
var cstageEl = document.getElementById("cstage");
var cchipsEl = document.getElementById("cchips");
function buildCChips(){
  cchipsEl.innerHTML = "";
  CVALS.forEach(function(cv, i){
    var b = document.createElement("button");
    b.className = "chip"; b.textContent = cv.label;
    b.setAttribute("aria-pressed", i === C.idx ? "true" : "false");
    b.addEventListener("click", function(){ C.idx = i; buildCChips(); cReset(); });
    cchipsEl.appendChild(b);
  });
}
function cReset(){
  C.step = 0; C.boxes = []; C.xAddr = null; C.yAddr = null;
  cverdictEl.className = "verdict"; cverdictEl.textContent = "";
  document.getElementById("cnameB").style.visibility = "hidden";
  renderC(); buildCSteps();
}
function renderC(){
  var cv = CVALS[C.idx];
  cboxesEl.innerHTML = "";
  C.boxes.forEach(function(b){
    var d = document.createElement("div");
    d.className = "obox active" + (b.born ? " born" : "");
    d.dataset.addr = b.addr;
    d.innerHTML = '<div class="ohead"><span>id: ' + b.addr + '</span><span>type: ' + cv.type + '</span></div>' +
                  '<div class="oval">' + esc(cv.label) + '</div>';
    cboxesEl.appendChild(d);
    b.born = false;
  });
  requestAnimationFrame(drawCWires);
}
function drawCWires(){
  var pa = document.getElementById("cwireA"), pb = document.getElementById("cwireB");
  var na = document.getElementById("cnameA"), nb = document.getElementById("cnameB");
  var ba = C.xAddr ? cboxesEl.querySelector('[data-addr="'+C.xAddr+'"]') : null;
  var bb = C.yAddr ? cboxesEl.querySelector('[data-addr="'+C.yAddr+'"]') : null;
  drawWire(pa, na, ba, cstageEl);
  if (C.yAddr && nb.style.visibility !== "hidden"){ drawWire(pb, nb, bb, cstageEl); } else { pb.setAttribute("d",""); }
}
function buildCSteps(){
  var cv = CVALS[C.idx];
  var defs = [
    {code:"x = " + cv.label, note:"first assignment"},
    {code:"y = " + cv.label, note:"same value, new name — what happens?"},
    {code:"x == y", note:"compare VALUES"},
    {code:"x is y", note:"compare IDENTITIES"}
  ];
  cstepsEl.innerHTML = "";
  defs.forEach(function(s, i){
    var b = document.createElement("button");
    b.className = "step";
    b.innerHTML = esc(s.code) + '<span class="snote">' + esc(s.note) + '</span>';
    b.disabled = (i !== C.step);
    b.addEventListener("click", function(){ runCStep(i); });
    cstepsEl.appendChild(b);
  });
  var r = document.createElement("button");
  r.className = "op quiet"; r.textContent = "reset"; r.style.marginTop = "4px";
  r.addEventListener("click", cReset);
  cstepsEl.appendChild(r);
}
function runCStep(i){
  if (i !== C.step) return;
  var cv = CVALS[C.idx];
  if (i === 0){
    var ca = newAddr();
    C.boxes = [{addr:ca, born:true}];
    C.xAddr = ca;
  } else if (i === 1){
    document.getElementById("cnameB").style.visibility = "visible";
    if (cv.shared){
      C.yAddr = C.xAddr;
      showCV("same", "Cache hit: " + cv.why);
    } else {
      var cb2 = {addr:newAddr(), born:true};
      C.boxes.push(cb2);
      C.yAddr = cb2.addr;
      showCV("new", "A second object was built. " + cv.why);
    }
  } else if (i === 2){
    showCV("info", "x == y → True. Double-equals compares values, and the values are equal either way.");
  } else if (i === 3){
    if (cv.shared){
      showCV("same", "x is y → True — one shared object (" + C.xAddr + "). Not because Python searched by value, but because this value is pre-built and handed out.");
    } else {
      showCV("new", "x is y → False — equal values, two identities (" + C.xAddr + " vs " + C.yAddr + "). Python never searches memory for an existing value.");
    }
  }
  C.step++;
  renderC(); buildCSteps();
}
function showCV(kind, text){
  cverdictEl.className = "verdict show " + kind;
  cverdictEl.textContent = text;
}

/* ---------- section 4: quiz ---------- */
var QUIZ = [
  {s:"A GPS coordinate you pass to five different functions.", a:"share", w:"Share it as a tuple — none of the five can surprise the others by changing it."},
  {s:"Collecting lines one by one while reading a big file.", a:"build", w:"Build with a list — append is cheap and in place; nobody else holds it yet."},
  {s:"A dict key combining a stock symbol and a date.", a:"share", w:"Keys must be hashable, so an immutable tuple like (\u201cTCS\u201d, \u201c2026-11-11\u201d)."},
  {s:"A game scoreboard that updates after every round.", a:"build", w:"Genuinely evolving state — a mutable dict is the natural home."},
  {s:"Counting pizza orders by their topping combination.", a:"share", w:"The combo is unordered and must be a key: frozenset({\u201ccheese\u201d, \u201ccorn\u201d})."},
  {s:"A shopping cart while the customer is still shopping.", a:"build", w:"You own it and it is accumulating — build it mutable, freeze later if shared."},
  {s:"Configuration settings read by every thread in a server.", a:"share", w:"Widely shared across threads — immutable means thread-safe by nature."},
  {s:"A default value for a function argument.", a:"share", w:"The classic trap: a mutable default (def f(x=[])) is shared across every call. Default to immutable (or None)."}
];
var qi = 0, qscore = 0, qdone = false;
var qscenEl = document.getElementById("qscen");
var qfeedEl = document.getElementById("qfeed");
var qprogEl = document.getElementById("qprog");
var qscoreEl = document.getElementById("qscore");
var qbuildBtn = document.getElementById("qbuild");
var qshareBtn = document.getElementById("qshare");
function qRender(){
  if (qi >= QUIZ.length){
    qscenEl.textContent = "Done! " + qscore + " / " + QUIZ.length + " — the rule held every time: build mutable, share immutable.";
    qbuildBtn.style.display = "none"; qshareBtn.style.display = "none";
    qfeedEl.className = "qfeed"; qfeedEl.innerHTML = "";
    qprogEl.innerHTML = '<button class="linkish" id="qagain">Play again</button>';
    qscoreEl.textContent = "";
    document.getElementById("qagain").addEventListener("click", function(){ qi=0; qscore=0; qbuildBtn.style.display=""; qshareBtn.style.display=""; qRender(); });
    return;
  }
  qscenEl.textContent = QUIZ[qi].s;
  qfeedEl.className = "qfeed"; qfeedEl.textContent = "";
  qprogEl.textContent = "Question " + (qi+1) + " of " + QUIZ.length;
  qscoreEl.textContent = "Score: " + qscore;
  qbuildBtn.disabled = false; qshareBtn.disabled = false;
}
function qAnswer(choice){
  var q = QUIZ[qi];
  var right = (choice === q.a);
  if (right) qscore++;
  qfeedEl.className = "qfeed show " + (right ? "right" : "wrong");
  qfeedEl.textContent = (right ? "Correct. " : "Not this time. ") + q.w;
  qbuildBtn.disabled = true; qshareBtn.disabled = true;
  qscoreEl.textContent = "Score: " + qscore;
  setTimeout(function(){ qi++; qRender(); }, 2600);
}
qbuildBtn.addEventListener("click", function(){ qAnswer("build"); });
qshareBtn.addEventListener("click", function(){ qAnswer("share"); });

/* ---------- boot ---------- */
buildChips();
resetStage(true);
setAliasChips();
aReset();
buildCChips();
cReset();
qRender();
window.addEventListener("resize", function(){ drawWireA(); drawAWires(); drawCWires(); });
})();
</script>
